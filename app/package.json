{
  "name": "clipsworld",
  "productName": "Clipsworld",
  "version": "1.4.0",
  "description": "AI clipping studio: turn long videos and streams into captioned Shorts.",
  "author": "Overworld Studio",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "studio.overworld.clipsworld",
    "productName": "Clipsworld",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "build-info.json"
    ],
    "extraResources": [
      {
        "from": "../dist-backend/clipsworld-backend",
        "to": "backend"
      },
      {
        "from": "../resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "../resources/fonts",
        "to": "fonts"
      },
      {
        "from": "../resources/sfx",
        "to": "sfx"
      },
      {
        "from": "../resources/deno",
        "to": "deno"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clipsworld",
      "artifactName": "Clipsworld-Setup-${version}.exe"
    }
  }
}